# Copy this file to .env.local and fill in real values when you add a backend.
# These are optional for now; the site works without them.

# Next.js / public site URL (used for Open Graph metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Business WhatsApp number in international format WITHOUT + (used by order button)
NEXT_PUBLIC_WHATSAPP_NUMBER=265994630808

# Reserve a slot for future backend keys, e.g.:
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=